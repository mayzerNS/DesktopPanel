<Window x:Class="DesktopPanel.UI.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopPanel.Core.Localization"
        xmlns:controls="clr-namespace:DesktopPanel.UI.Controls"
        xmlns:overlay="clr-namespace:DesktopPanel.UI.Overlay"
        xmlns:theme="clr-namespace:DesktopPanel.UI.Theme"
        Title="DesktopPanel"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowActivated="True" TextOptions.TextHintingMode="Fixed">

    <!-- Окно без рамки и заголовка. Размытый фон рисует Windows (UI/Theme/Glass.cs), затемнение — слой Tint. -->
    <Grid>
        <!-- визуализация музыки — под затемнением и сама размыта: как будто за стеклом (MusicBars) -->
        <overlay:MusicBars x:Name="Music" />
        <!-- затемнение (ползунок «Затемнение») поверх размытого фона -->
        <Border x:Name="Tint" Background="Black" Opacity="0.35" IsHitTestVisible="False" />
        <!-- обводка окна: еле заметная светлая линия, видна и на тёмном, и на светлом фоне
             (радиус — как у скругления окон Windows 11) -->
        <Border x:Name="OuterFrame" BorderBrush="{StaticResource WindowFrameBrush}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" Panel.ZIndex="10" />

        <Grid x:Name="Body" Margin="7,7,7,14" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- корзина: квадрат слева от шапки, высотой с шапку; отступ до шапки — 7, как от шапки до края окна.
                 При наведении (и когда на неё тащат значок) чуть растёт вправо и вниз, к значкам рабочего стола.
                 Рост и крышку ведёт DesktopView (SetTrashScale); нижнее поле отрицательное на величину роста — строка шапки
                 по высоте не меняется. Шапка не в соседней колонке, а на всю ширину с левым полем «корзина + 7» (его тоже ставит
                 SetTrashScale): правый край шапки и кнопки от роста корзины не зависят, сдвигается только левый край с надписью. -->
            <Border x:Name="TrashZone" Grid.Row="0" Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="48" Height="48" Margin="0,0,7,0" CornerRadius="8" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <!-- нажатие — как у кнопок шапки и свёрнутой лупы: слой нажатия проявляется, значок вдавливается (Fx.Press
                         у TrashGlyphs, а не у плашки: размер плашки ведёт рост корзины), срабатывает по отпусканию над ней -->
                    <!-- наведение в режиме «Назад» — слой, как у кнопок шапки (корзина вместо этого подрастает к значкам) -->
                    <Border x:Name="TrashHoverLayer" CornerRadius="7" Background="#10FFFFFF" BorderBrush="#43FFFFFF" BorderThickness="1"
                            Margin="-1" Opacity="0" IsHitTestVisible="False" />
                    <Border x:Name="TrashPressLayer" CornerRadius="7" Background="#16FFFFFF" Opacity="0" IsHitTestVisible="False" />
                    <Grid x:Name="TrashGlyphs">
                    <!-- значок — вектор без привязки к пикселям (сглаживание) и с еле заметным размытием краёв;
                         крышка (линия + ручка) отдельно — открывается вместе с ростом плашки -->
                    <Viewbox x:Name="TrashGlyph" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                             UseLayoutRounding="False" SnapsToDevicePixels="False">
                        <Canvas Width="24" Height="24">
                            <Canvas.Effect>
                                <BlurEffect Radius="0.6" KernelType="Gaussian" RenderingBias="Quality" />
                            </Canvas.Effect>
                            <Path Stroke="White" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5.6,6 L6.6,19 Q6.8,20.8 8.6,20.8 H15.4 Q17.2,20.8 17.4,19 L18.4,6 M10,10 V16.6 M14,10 V16.6" />
                            <Path Stroke="White" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M3.5,6 H20.5 M9,6 V4.6 Q9,3.4 10.2,3.4 H13.8 Q15,3.4 15,4.6 V6">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <!-- петля слева: открывается правый край -->
                                        <RotateTransform x:Name="TrashLidTurn" CenterX="3.5" CenterY="6" />
                                        <TranslateTransform x:Name="TrashLidLift" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                    <!-- на других вкладках плашка — кнопка «Назад»: стрелка с округлыми концами в той же сетке 24 и тем же штрихом -->
                    <Viewbox x:Name="BackGlyph" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                             UseLayoutRounding="False" SnapsToDevicePixels="False" Opacity="0" Visibility="Collapsed">
                        <Viewbox.RenderTransform>
                            <TranslateTransform x:Name="BackShift" />
                        </Viewbox.RenderTransform>
                        <Canvas Width="24" Height="24">
                            <Canvas.Effect>
                                <BlurEffect Radius="0.6" KernelType="Gaussian" RenderingBias="Quality" />
                            </Canvas.Effect>
                            <Path Stroke="White" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M19.5,12 H5.2 M10.6,6.2 L4.8,12 L10.6,17.8" />
                        </Canvas>
                    </Viewbox>
                    </Grid>
                </Grid>
            </Border>

            <!-- фон шапки — отдельная пустая подложка: при росте корзины двигается только её левый край. Содержимое шапки
                 (HeaderPlate) раскладку не меняет — иначе каждый кадр всё в ней заново округлялось до пикселей и кнопки дрожали;
                 надпись сдвигается смещением отрисовки (TitleShift), которое раскладку не трогает. -->
            <Border x:Name="HeaderBg" Grid.Row="0" Margin="55,0,0,0" CornerRadius="8" BorderThickness="1" Background="#14FFFFFF"
                    BorderBrush="#26FFFFFF" IsHitTestVisible="False" />

            <!-- шапка; за любое место (кроме кнопок и поиска) окно и плашку в уголке можно тащить -->
            <Border x:Name="HeaderPlate" Grid.Row="0" Margin="55,0,0,0" CornerRadius="8" BorderThickness="1" Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                    BorderBrush="Transparent" Padding="10,6,6,6">
            <Grid x:Name="Header" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ручки нет: окно (и плашку в уголке) тащат за саму панель шапки — за любое место, кроме кнопок и поиска -->

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}"
                               VerticalAlignment="Center" Text="{loc:L overlay.desktop}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="TitleShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>

                <controls:NoGrowPanel x:Name="SearchArea" Grid.Column="2" Margin="5,0,0,0" SizeChanged="SearchArea_SizeChanged">
                    <!-- поиск: значок лупы внутри поля -->
                    <!-- свёрнут в квадрат с лупой у правого края; щелчок (или набор текста) плавно разворачивает -->
                    <!-- свёрнутая лупа — та же кнопка, что и остальные в шапке: подсветка наведения и нажатия (слои Fx.Show),
                         вдавливание (Fx.Press), открывается по отпусканию; развёрнутое поле подсвечивает уже само (InputBox) -->
                    <!-- ширина поля никогда не больше места (MaxWidth): иначе на ходу поле на долю пикселя раздвигало шапку
                         и толкало кнопки справа -->
                    <Grid x:Name="SearchHost" Width="40" Height="32" HorizontalAlignment="Right" Background="Transparent"
                          MaxWidth="{Binding ActualWidth, ElementName=SearchArea}"
                          MouseLeftButtonDown="SearchHost_MouseDown" MouseLeftButtonUp="SearchHost_MouseUp"
                          MouseEnter="SearchHost_Hover" MouseLeave="SearchHost_Hover" LostMouseCapture="SearchHost_LostCapture">
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="32,0,10,0" IsHitTestVisible="False"
                                 LostKeyboardFocus="SearchBox_LostFocus"
                                 Tag="{loc:L overlay.search}"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <Border x:Name="SearchHoverLayer" CornerRadius="8" BorderThickness="1" Background="#10FFFFFF"
                                BorderBrush="#43FFFFFF" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="SearchPressLayer" CornerRadius="8" Background="#16FFFFFF" Opacity="0" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchGlyph" Text="&#xE721;" FontFamily="{StaticResource GlyphFont}" FontSize="13"
                                   Foreground="#A0FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Margin="13,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </controls:NoGrowPanel>

                <!-- место под кнопки держит пустышка той же ширины, а сами кнопки прижаты к правому краю всей шапки:
                     так их место не зависит от округления ширины колонок слева (при росте корзины кнопки «плавали») -->
                <Border x:Name="ButtonsSpace" Grid.Column="3" Width="{Binding ActualWidth, ElementName=HeaderButtons}" />
                <StackPanel x:Name="HeaderButtons" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Orientation="Horizontal">
                    <controls:IconButton x:Name="HdrButton" Glyph="&#xE706;" Visibility="Collapsed" Click="Hdr_Click"
                                         MouseRightButtonUp="Hdr_RightClick" />
                    <!-- правая кнопка по HDR: яркость SDR-контента (как в «Параметры → Дисплей → HDR») -->
                    <Popup x:Name="SdrPopup" PlacementTarget="{Binding ElementName=HdrButton}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                        <Border x:Name="SdrCard" Background="{DynamicResource MenuBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" theme:Fx.PopIn="True">
                            <StackPanel>
                                <TextBlock Text="{loc:L hdr.sdr}" Foreground="White" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <Slider x:Name="SdrSlider" Width="200" Minimum="0" Maximum="100" SmallChange="1"
                                            LargeChange="5" VerticalAlignment="Center" ValueChanged="SdrSlider_ValueChanged" />
                                    <TextBlock x:Name="SdrValue" Width="44" Foreground="White" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="SdrHint" Text="{loc:L hdr.sdr_off}" Foreground="#99FFFFFF" FontSize="12"
                                           Margin="0,6,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <controls:IconButton x:Name="ZapretButton" Glyph="&#xE83D;" Visibility="Collapsed"
                                         Click="ZapretButton_Click" MouseRightButtonUp="ZapretButton_RightClick" />
                    <controls:IconButton x:Name="TgButton" Glyph="&#xE724;" Visibility="Collapsed"
                                         Click="TgButton_Click" MouseRightButtonUp="TgButton_RightClick" />
                    <controls:IconButton x:Name="TasksButton" Glyph="&#xE9D9;" Click="Tasks_Click" />
                    <controls:IconButton x:Name="PipButton" Glyph="&#xF6FA;" Click="Pip_Click" />
                    <controls:IconButton x:Name="IconsButton" Glyph="&#xE7B3;" Click="IconsButton_Click" />
                    <controls:IconButton x:Name="SettingsButton" Glyph="&#xE713;" Click="SettingsButton_Click" />
                    <controls:IconButton x:Name="MinimizeButton" Glyph="&#xE921;" Click="Minimize_Click" />
                    <controls:IconButton x:Name="ExpandButton" Glyph="&#xE740;" Visibility="Collapsed" Click="Expand_Click" />
                    <!-- уголок: свернуть к краю экрана (видна только в уголке) -->
                    <controls:IconButton x:Name="CollapseButton" Glyph="&#xE76C;" Visibility="Collapsed" Click="Collapse_Click" />
                    <controls:IconButton x:Name="CloseButton" Glyph="&#xE8BB;" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>
            </Border>

            <!-- страницы -->
            <!-- выше плашки корзины (ZIndex 1): значок, который тащат в корзину, — поверх неё, а не под полупрозрачной подложкой -->
            <Grid x:Name="Pages" Grid.Row="1" Margin="11,10,11,0" Panel.ZIndex="2">
                <overlay:DesktopView x:Name="DesktopPage" />
                <overlay:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                <overlay:ZapretView x:Name="ZapretPage" Visibility="Collapsed" />
                <overlay:TasksView x:Name="TasksPage" Visibility="Collapsed" />
                <overlay:TrashView x:Name="TrashPage" Visibility="Collapsed" />
                <overlay:ConfirmView x:Name="ConfirmPage" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</Window>
