<UserControl x:Class="DesktopPanel.UI.Overlay.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopPanel.Core.Localization"
             xmlns:controls="clr-namespace:DesktopPanel.UI.Controls">
    <UserControl.Resources>
        <!-- строка «заголовок + пояснение слева, переключатель справа» внутри блока -->
        <Style x:Key="OptionText" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,64,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- разделы, как в «Параметрах» Windows -->
        <StackPanel x:Name="Nav" Margin="0,0,14,0" />

        <ScrollViewer x:Name="Scroll" Grid.Column="1" Style="{StaticResource PageScroll}" controls:SmoothScroll.Step="90">
            <Grid>

                <!-- ===== внешний вид ===== -->
                <StackPanel x:Name="SecLook">
                    <controls:Box Title="{loc:L settings.look}">
                        <StackPanel>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowSubText}" VerticalAlignment="Center"
                                       Text="{loc:L settings.darkness}" />
                            <Slider x:Name="DarknessSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" ValueChanged="Look_ValueChanged" />
                            <TextBlock x:Name="DarknessValue" Grid.Column="2" Style="{StaticResource RowSubText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,10,0,2">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.music}" />
                            </StackPanel>
                            <CheckBox x:Name="MusicSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="Music_Click" />
                        </Grid>
                        </StackPanel>
                    </controls:Box>
                    <controls:Box Title="{loc:L settings.grid}">
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowSubText}" VerticalAlignment="Center"
                                       Text="{loc:L settings.grid.icon}" />
                            <Slider x:Name="IconSizeSlider" Grid.Column="1" Minimum="1" Maximum="5" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="Grid_ValueChanged" />
                            <TextBlock x:Name="IconSizeValue" Grid.Column="2" Style="{StaticResource RowSubText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </controls:Box>
                    <controls:Box Title="{loc:L settings.accent}">
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.accent.system}" />
                            </StackPanel>
                            <CheckBox x:Name="AccentSystemSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="AccentSystem_Click" />
                        </Grid>
                        <!-- палитра как в «Параметры → Персонализация → Цвета» (заполняет код) -->
                        <WrapPanel x:Name="AccentSwatches" />
                    </controls:Box>
                    <controls:Box Title="{loc:L settings.tips}">
                        <controls:Box.HeaderRight>
                            <controls:Segmented x:Name="TipsSeg" />
                        </controls:Box.HeaderRight>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowSubText}" VerticalAlignment="Center"
                                       Text="{loc:L settings.tips.opacity}" />
                            <Slider x:Name="TipsOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center" ValueChanged="TipsOpacity_ValueChanged" />
                            <TextBlock x:Name="TipsOpacityValue" Grid.Column="2" Style="{StaticResource RowSubText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </controls:Box>
                </StackPanel>

                <!-- ===== сочетания клавиш ===== -->
                <StackPanel x:Name="SecHotkeys" Visibility="Collapsed">
                    <controls:Row x:Name="HotkeyRow" Title="{loc:L settings.hotkey.title}" Sub="{loc:L settings.hotkey.sub}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HotkeyDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ToggleButton x:Name="WinToggle" Style="{StaticResource PanelToggle}" Content="Win"
                                          Margin="0,0,6,0" Click="WinToggle_Click" />
                            <controls:HotkeyBox x:Name="HotkeyInput" Style="{StaticResource InputBox}" Width="150"
                                                HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.takeover}" Sub="{loc:L settings.takeover.sub}" Help="takeover">
                        <CheckBox x:Name="TakeoverSwitch" Style="{StaticResource ToggleSwitch}" Click="Takeover_Click" />
                    </controls:Row>
                    <!-- действия программы на сочетаниях: по умолчанию не назначены; точка — работает ли сочетание -->
                    <controls:Box Title="{loc:L settings.shortcuts}">
                        <TextBlock x:Name="ShortcutStatus" Style="{StaticResource RowSubText}" Margin="0,0,0,8"
                                   Text="{loc:L settings.shortcuts.sub}" />
                        <StackPanel x:Name="ShortcutRows" />
                    </controls:Box>
                </StackPanel>

                <!-- ===== панель ===== -->
                <StackPanel x:Name="SecPanel" Visibility="Collapsed">
                    <controls:Box Title="{loc:L settings.games}" Help="games">
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.games.minimize}" />
                                <TextBlock Style="{StaticResource RowSubText}" Text="{loc:L settings.games.minimize.sub}" />
                            </StackPanel>
                            <CheckBox x:Name="GameMinimizeSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="Games_Click" />
                        </Grid>
                        <Grid>
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.games.restore}" />
                                <TextBlock Style="{StaticResource RowSubText}" Text="{loc:L settings.games.restore.sub}" />
                            </StackPanel>
                            <CheckBox x:Name="GameRestoreSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="Games_Click" />
                        </Grid>
                    </controls:Box>
                </StackPanel>

                <!-- ===== рабочий стол ===== -->
                <StackPanel x:Name="SecDesktop" Visibility="Collapsed">
                    <controls:Row Title="{loc:L settings.search}">
                        <CheckBox x:Name="SearchSwitch" Style="{StaticResource ToggleSwitch}" Click="Desktop_Click" />
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.search_system}">
                        <CheckBox x:Name="SearchSystemSwitch" Style="{StaticResource ToggleSwitch}" Click="Desktop_Click" />
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.recycle}">
                        <CheckBox x:Name="RecycleSwitch" Style="{StaticResource ToggleSwitch}" Click="Desktop_Click" />
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.dblclick}">
                        <CheckBox x:Name="DoubleClickSwitch" Style="{StaticResource ToggleSwitch}" Click="Desktop_Click" />
                    </controls:Row>
                </StackPanel>

                <!-- ===== мини-браузер ===== -->
                <StackPanel x:Name="SecPip" Visibility="Collapsed">
                    <controls:Row Title="{loc:L settings.pip}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PipOpenButton" Style="{StaticResource PanelButton}" Margin="0,0,12,0"
                                    Content="{loc:L settings.pip.open}" Click="PipOpen_Click" />
                            <CheckBox x:Name="PipSwitch" Style="{StaticResource ToggleSwitch}" Click="PipSwitch_Click" />
                        </StackPanel>
                    </controls:Row>
                    <controls:Box x:Name="PipBody" Title="{loc:L settings.pip.window}">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowSubText}" VerticalAlignment="Center"
                                       Text="{loc:L settings.pip.size}" />
                            <Slider x:Name="PipSizeSlider" Grid.Column="1" Minimum="320" Maximum="1600"
                                    VerticalAlignment="Center" ValueChanged="PipSize_ValueChanged" />
                            <TextBlock x:Name="PipSizeValue" Grid.Column="2" Style="{StaticResource RowSubText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.pip.aspect}" />
                            </StackPanel>
                            <controls:Segmented x:Name="PipAspectSeg" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.pip.auto}" />
                                <TextBlock Style="{StaticResource RowSubText}" Text="{loc:L settings.pip.auto.sub}" />
                            </StackPanel>
                            <CheckBox x:Name="PipAutoSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="PipOptions_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.pip.double}" />
                            </StackPanel>
                            <CheckBox x:Name="PipDoubleSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="PipOptions_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.pip.autopause}" />
                            </StackPanel>
                            <CheckBox x:Name="PipPauseSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="PipOptions_Click" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.pip.freemem}" />
                            </StackPanel>
                            <CheckBox x:Name="PipFreeMemSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="PipOptions_Click" />
                        </Grid>
                        <Button Style="{StaticResource PanelButton}" HorizontalAlignment="Left"
                                Content="{loc:L settings.pip.reset_place}" Click="PipResetPlace_Click" />
                    </controls:Box>
                    <controls:Box Title="{loc:L settings.pip.hotkeys}">
                        <TextBlock x:Name="PipHotkeyStatus" Style="{StaticResource RowSubText}" Margin="0,0,0,8"
                                   Text="{loc:L settings.pip.hotkeys.sub}" />
                        <StackPanel x:Name="PipHotkeyRows" />
                    </controls:Box>
                </StackPanel>

                <!-- ===== Zapret ===== -->
                <StackPanel x:Name="SecZapret" Visibility="Collapsed">
                    <controls:Row x:Name="ZapretRow" Title="{loc:L settings.zapret.title}" Help="zapret">
                        <CheckBox x:Name="ZapretSwitch" Style="{StaticResource ToggleSwitch}" Click="ZapretSwitch_Click" />
                    </controls:Row>
                    <controls:Row x:Name="ZapretOpenRow" Title="{loc:L settings.zapret.open}" Sub="{loc:L settings.zapret.open.sub}">
                        <Button Style="{StaticResource PanelButton}" Content="{loc:L zapret.open}" Click="ZapretOpen_Click" />
                    </controls:Row>
                    <controls:Row x:Name="ZapretResetRow" Title="{loc:L zapret.uninstall}" Sub="{loc:L zapret.uninstall.sub}">
                        <Button x:Name="ZapretResetButton" Style="{StaticResource DangerButton}"
                                Content="{loc:L zapret.uninstall.button}" Click="ZapretReset_Click" />
                    </controls:Row>
                </StackPanel>

                <!-- ===== прокси для Telegram (tg-ws-proxy) ===== -->
                <StackPanel x:Name="SecTelegram" Visibility="Collapsed">
                    <controls:Row x:Name="TgRow" Title="{loc:L settings.tg.title}" Help="tgproxy">
                        <CheckBox x:Name="TgSwitch" Style="{StaticResource ToggleSwitch}" Click="TgSwitch_Click" />
                    </controls:Row>
                    <StackPanel x:Name="TgBody">
                        <controls:Row x:Name="TgStateRow" Title="{loc:L settings.tg.state}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TgRestartButton" Style="{StaticResource PanelButton}" Margin="0,0,8,0"
                                        Content="{loc:L settings.tg.restart}" Click="TgRestart_Click" />
                                <Button x:Name="TgToggleButton" Style="{StaticResource AccentButton}" Click="TgToggle_Click" />
                            </StackPanel>
                        </controls:Row>
                        <controls:Row Title="{loc:L settings.tg.connect}" Sub="{loc:L settings.tg.connect.sub}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PanelButton}" Margin="0,0,8,0"
                                        Content="{loc:L settings.tg.copy}" Click="TgCopy_Click" />
                                <Button Style="{StaticResource AccentButton}" Content="{loc:L settings.tg.open_tg}"
                                        Click="TgConnect_Click" />
                            </StackPanel>
                        </controls:Row>
                        <controls:Row Title="{loc:L settings.tg.ipv6}" Sub="{loc:L settings.tg.ipv6.sub}">
                            <CheckBox x:Name="TgIpv6Switch" Style="{StaticResource ToggleSwitch}" Click="TgIpv6_Click" />
                        </controls:Row>
                        <controls:Row x:Name="TgPortRow" Title="{loc:L settings.tg.port}" Sub="{loc:L settings.tg.port.sub}">
                            <TextBox x:Name="TgPortBox" Style="{StaticResource InputBox}" Width="90"
                                     HorizontalContentAlignment="Center" LostFocus="TgPort_Apply" KeyDown="TgPort_KeyDown" />
                        </controls:Row>
                        <controls:Row x:Name="TgVersionRow" Title="{loc:L settings.tg.version}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PanelButton}" Margin="0,0,8,0"
                                        Content="{loc:L settings.tg.log}" Click="TgLog_Click" />
                                <Button Style="{StaticResource PanelButton}" Content="{loc:L settings.tg.update}"
                                        Click="TgUpdate_Click" />
                            </StackPanel>
                        </controls:Row>
                    </StackPanel>
                </StackPanel>

                <!-- ===== система ===== -->
                <StackPanel x:Name="SecSystem" Visibility="Collapsed">
                    <controls:Box Title="{loc:L settings.perf}">
                        <Grid Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource OptionText}">
                                <TextBlock Style="{StaticResource RowTitleText}" Text="{loc:L settings.perf.anim}" />
                                <TextBlock Style="{StaticResource RowSubText}" Text="{loc:L settings.perf.anim.sub}" />
                            </StackPanel>
                            <CheckBox x:Name="AnimSwitch" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="Anim_Click" />
                        </Grid>
                        <Grid x:Name="FpsRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowSubText}" VerticalAlignment="Center"
                                       Text="{loc:L settings.perf.fps}" />
                            <Slider x:Name="FpsSlider" Grid.Column="1" Minimum="30" Maximum="360" TickFrequency="10"
                                    IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Fps_ValueChanged" />
                            <TextBlock x:Name="FpsValue" Grid.Column="2" Style="{StaticResource RowSubText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </controls:Box>
                    <controls:Row Title="{loc:L settings.autostart}">
                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource ToggleSwitch}" Click="AutostartSwitch_Click" />
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.wizard}" Sub="{loc:L settings.wizard.sub}">
                        <Button Style="{StaticResource PanelButton}" Content="{loc:L settings.wizard.run}" Click="Wizard_Click" />
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.logs.title}" Sub="{loc:L settings.logs.sub}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PanelButton}" Content="{loc:L settings.logs.open}" Click="Logs_Click" />
                            <Button Style="{StaticResource PanelButton}" Content="{loc:L settings.logs.clear}" Click="LogsClear_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.exit.title}" Sub="{loc:L settings.exit.sub}">
                        <Button Style="{StaticResource DangerButton}" Content="{loc:L settings.exit.button}" Click="Exit_Click" />
                    </controls:Row>
                    <controls:Row Title="{loc:L settings.uninstall}" Sub="{loc:L settings.uninstall.sub}">
                        <Button Style="{StaticResource DangerButton}" Content="{loc:L settings.uninstall.app}"
                                Click="UninstallApp_Click" />
                    </controls:Row>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
