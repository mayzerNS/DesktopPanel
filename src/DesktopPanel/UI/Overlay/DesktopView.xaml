<UserControl x:Class="DesktopPanel.UI.Overlay.DesktopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DesktopPanel.Core.Localization"
             xmlns:controls="clr-namespace:DesktopPanel.UI.Controls"
             xmlns:theme="clr-namespace:DesktopPanel.UI.Theme"
             PreviewMouseMove="Root_PreviewMouseMove" PreviewMouseLeftButtonUp="Root_PreviewMouseUp"
             LostMouseCapture="Root_LostMouseCapture">
    <UserControl.Resources>
        <!-- плитка: значок (или 4 мини-значка группы) и подпись -->
        <DataTemplate x:Key="TileTemplate">
            <!-- CacheMode: плитка всегда рисуется готовой картинкой — сглаженной (см. DesktopView.UpdateTileCache) -->
            <Button Style="{StaticResource TileButton}" Click="Tile_Click" MouseRightButtonUp="Tile_RightClick"
                    PreviewMouseLeftButtonDown="Tile_MouseDown" ToolTip="{Binding Tip}" ToolTipOpening="Tile_ToolTipOpening"
                    Opacity="{Binding TileOpacity}"
                    CacheMode="{DynamicResource TileCache}"
                    theme:Tips.Info="True">
                <Grid>
                    <!-- принимающий значок «раздувается» и обволакивает входящий (когда подержали достаточно для папки) -->
                    <Border x:Name="Blob" CornerRadius="18" Background="#38FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                            Width="{DynamicResource IconBox}" Height="{DynamicResource IconBox}" Margin="0,8,0,0"
                            VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5" theme:Fx.Swell="{Binding IsDropTarget}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel>
                        <!-- размер значка — из настроек (ресурс IconBox); внутри всё рассчитано на 64 и масштабируется -->
                        <Viewbox Width="{DynamicResource IconBox}" Height="{DynamicResource IconBox}" Margin="0,8,0,0">
                        <Grid Width="64" Height="64">
                            <!-- скруглённые углы значка (у прозрачных значков незаметно, у квадратных — как в Windows 11) -->
                            <Image Source="{Binding Icon}" Visibility="{Binding ItemVisibility}"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12" />
                                </Image.Clip>
                            </Image>
                            <Border CornerRadius="14" Background="#30FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                                    Visibility="{Binding GroupVisibility}">
                                <ItemsControl ItemsSource="{Binding Previews}" Margin="7" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="2" Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding}" Width="22" Height="22" Margin="1"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,22,22" RadiusX="4.5" RadiusY="4.5" />
                                                </Image.Clip>
                                            </Image>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                        </Viewbox>
                        <!-- подпись: тень — ровный ореол вокруг букв (а не полоса снизу), буквы — с подгонкой к пикселям (чётче) -->
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   TextOptions.TextFormattingMode="Display"
                                   TextAlignment="Center" MaxHeight="42" Margin="0,6,0,0" Width="{DynamicResource TileTextWidth}" Foreground="White">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.6" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="TilePanel">
            <!-- по центру; размер клетки — из настроек (ресурсы TileWidth, TileHeight) -->
            <WrapPanel ItemWidth="{DynamicResource TileWidth}" ItemHeight="{DynamicResource TileHeight}"
                       HorizontalAlignment="Center" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- все значки + найденное в системе -->
        <Grid x:Name="MainArea" Background="Transparent" MouseRightButtonUp="Background_RightClick">
            <!-- корзина теперь в шапке (OverlayWindow), значкам — вся ширина -->
            <!-- Margin -10 сверху: прокрутка начинается прямо под шапкой (поле страницы 10 px — у самой сетки, TileGrid.Margin,
                 FitColumns): пузырь папки-приёмника в первом ряду (выходит над плиткой до 10 px) не обрезается краем прокрутки -->
            <ScrollViewer x:Name="Scroll" Style="{StaticResource DesktopScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,-10,0,0"
                          Focusable="False" controls:SmoothScroll.Step="116">
                <!-- ⚠ отступ сверху — у этой обёртки, НЕ у TileGrid: снимок сетки (MakeCover, RenderTargetBitmap) рисует
                     её вместе с её собственным полем — с полем у TileGrid снимок съезжал вниз, и при подмене живыми плитками
                     все значки передёргивались (расформирование, корзина, перестановка) -->
                <StackPanel x:Name="TileStack">
                    <ItemsControl x:Name="TileGrid" Focusable="False" ItemTemplate="{StaticResource TileTemplate}"
                                  ItemsPanel="{StaticResource TilePanel}" />
                    <StackPanel x:Name="SearchSection" Visibility="Collapsed">
                        <TextBlock x:Name="AppsTitle" Style="{StaticResource RowTitleText}" Margin="4,10,0,4"
                                   Text="{loc:L desktop.search.apps}" />
                        <ItemsControl x:Name="AppsGrid" Focusable="False" ItemTemplate="{StaticResource TileTemplate}"
                                      ItemsPanel="{StaticResource TilePanel}" />
                        <TextBlock x:Name="FilesTitle" Style="{StaticResource RowTitleText}" Margin="4,10,0,4"
                                   Text="{loc:L desktop.search.files}" />
                        <ItemsControl x:Name="FilesGrid" Focusable="False" ItemTemplate="{StaticResource TileTemplate}"
                                      ItemsPanel="{StaticResource TilePanel}" />
                        <TextBlock x:Name="SearchStatus" Style="{StaticResource RowSubText}" Margin="4,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="NothingFound" Style="{StaticResource RowSubText}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                       Text="{loc:L overlay.nothing_found}" />

            <!-- найденное можно перетащить сюда — появится ярлык на рабочем столе -->
            <Border x:Name="DropBar" VerticalAlignment="Top" Height="56" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentEdgeBrush}" Background="#E0202026" Visibility="Collapsed">
                <TextBlock x:Name="DropBarText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Text="{loc:L desktop.search.drop}" />
            </Border>

        </Grid>

        <!-- открытая группа: затемнение (сюда можно вытащить значок из группы) и сама группа -->
        <Border x:Name="GroupLayer" Background="#80000000" CornerRadius="8" Visibility="Collapsed"
                MouseLeftButtonDown="GroupBackdrop_MouseDown">
            <Border x:Name="GroupPanel" Background="{DynamicResource TipBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,14,16,10" MinWidth="320" MaxWidth="700" MaxHeight="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MouseLeftButtonDown="GroupPanel_MouseDown">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GroupName" Style="{StaticResource InputBox}" FontSize="15"
                                 Tag="{loc:L desktop.group.name_hint}"
                                 KeyDown="GroupName_KeyDown" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- подтвердить (Enter) и отмена (Esc): в обоих случаях группа сворачивается -->
                            <Button Style="{StaticResource GlyphButton}" Margin="8,0,0,0" Content="&#xE73E;"
                                    Click="GroupConfirm_Click" />
                            <Button Style="{StaticResource GlyphButton}" Margin="6,0,0,0" Content="&#xE711;"
                                    Click="GroupClose_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="GroupHint" DockPanel.Dock="Bottom" Style="{StaticResource RowSubText}" Visibility="Collapsed"
                               Margin="0,6,0,0" Text="{loc:L desktop.group.hint}" />
                    <ScrollViewer Style="{StaticResource OverlayScroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" controls:SmoothScroll.Step="116">
                        <ItemsControl x:Name="GroupGrid" Focusable="False" ItemTemplate="{StaticResource TileTemplate}"
                                      ItemsPanel="{StaticResource TilePanel}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- переименование и новая группа -->
        <Border x:Name="RenameLayer" Background="#80000000" CornerRadius="8" Visibility="Collapsed"
                MouseLeftButtonDown="RenameBackdrop_MouseDown">
            <Border x:Name="RenameCard" Background="{DynamicResource TipBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="22,20,22,18" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="GroupPanel_MouseDown">
                <StackPanel>
                    <TextBlock x:Name="RenameTitle" Style="{StaticResource TitleText}" FontSize="17" Margin="2,0,0,14"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="RenameSub" Style="{StaticResource RowSubText}" Margin="2,-6,0,12" TextWrapping="Wrap"
                               Text="{loc:L desktop.rename.sub}" />
                    <TextBox x:Name="RenameBox" Style="{StaticResource InputBox}" Height="38" KeyDown="RenameBox_KeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource PanelButton}" Margin="0,0,10,0" MinWidth="92"
                                Content="{loc:L confirm.cancel}" Click="RenameCancel_Click" />
                        <Button Style="{StaticResource AccentButton}" MinWidth="110" Content="{loc:L desktop.rename.ok}"
                                Click="RenameOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- «Отменить» после изменения -->
        <Border x:Name="UndoToast" Background="{DynamicResource TipBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,6,6,6" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" TextElement.FontSize="12.5">
                <TextBlock x:Name="UndoText" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="UndoButton" Style="{StaticResource PanelButton}" Content="{loc:L desktop.undo}"
                        Click="Undo_Click" />
            </StackPanel>
        </Border>

        <!-- то, что сейчас тащат мышью -->
        <Canvas x:Name="DragLayer" IsHitTestVisible="False">
            <!-- значок «в руке»: размеры, скругление и подпись как у обычной плитки (размер задаёт код) -->
            <Border x:Name="Ghost" Visibility="Collapsed" Opacity="0.95" TextOptions.TextHintingMode="Fixed">
                <StackPanel>
                    <Image x:Name="GhostImage" Margin="0,8,0,0" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="GhostText" TextOptions.TextFormattingMode="Display" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="42" Margin="6,6,6,0" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="0" Opacity="0.6" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
