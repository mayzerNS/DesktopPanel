<!--
  Единый стиль программы. Цвет акцента Windows подставляется на лету (Accent.cs): {DynamicResource AccentBrush} и др.
  Всё рисует WPF со сглаживанием — скругления и обводки ровные при любом масштабе экрана.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:theme="clr-namespace:DesktopPanel.UI.Theme">

    <!-- значения по умолчанию; Accent.cs заменит их цветом Windows -->
    <Color x:Key="AccentColor">#0078D7</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#960078D7" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C80078D7" />
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="#D75AA5E6" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF" />
    <!-- фон подсказок; прозрачность меняется в настройках (Tips.cs) -->
    <SolidColorBrush x:Key="TipBrush" Color="#F01E1E24" />
    <SolidColorBrush x:Key="MenuBrush" Color="#F4202026" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="ControlEdgeBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverEdgeBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#3CFFFFFF" />
    <SolidColorBrush x:Key="PlateBrush" Color="#10FFFFFF" />
    <!-- тонкие светлые рамки — два семейства, одни на всю программу:
         окно со стеклом (панель, уголок, мастер) — по самому краю окна, радиус Corners.WindowDip;
         всплывающее и карточки поверх стекла (подсказки, меню, яркость SDR, панель и поиск мини-браузера, группа, тост) -->
    <SolidColorBrush x:Key="WindowFrameBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="PopupEdgeBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#46D63030" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D7D63030" />
    <SolidColorBrush x:Key="DangerEdgeBrush" Color="#96F06E64" />

    <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== текст ===== -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="RowTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="RowSubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===== подложка строки настроек ===== -->
    <Style x:Key="Plate" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PlateBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ===== кнопки =====
         Состояния не переключаются мгновенно, а перетекают (UI/Theme/Fx.cs): подсветка наведения и нажатия — отдельные слои,
         которые плавно проявляются (Fx.Show); при нажатии кнопка чуть «вдавливается» и пружинкой возвращается (Fx.Press);
         недоступная — плавно бледнеет (Fx.Dim). Тем же ходом, что и плитки рабочего стола. -->
    <Style x:Key="PanelButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid x:Name="Root" theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                          theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                        <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" Background="#10FFFFFF"
                                BorderBrush="#43FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="8" Background="#16FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- кнопка-значок (шестерёнка, крестик…) -->
    <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
        <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- кнопка без подложки (стрелки, мелкие значки): только подсветка при наведении и отклик на нажатие -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent"
                          theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                          theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border CornerRadius="6" Background="#30FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="6" Background="#18FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- переключаемая кнопка: выбрана — цвет акцента (проявляется плавно) -->
    <Style x:Key="PanelToggle" TargetType="ToggleButton" BasedOn="{StaticResource PanelButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                          theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                        <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                                Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" Background="#10FFFFFF"
                                BorderBrush="#43FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="8" Background="#16FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlyphToggle" TargetType="ToggleButton" BasedOn="{StaticResource PanelToggle}">
        <Setter Property="FontFamily" Value="{StaticResource GlyphFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- пункт меню слева (разделы настроек): выбран — подсветка и метка цвета акцента (метка вырастает) -->
    <Style x:Key="NavToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="Transparent"
                          theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border CornerRadius="8" Background="{StaticResource ControlFillBrush}" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="8" Background="{StaticResource ControlHoverBrush}" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid Margin="12,0">
                            <Border x:Name="Mark" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                    Margin="-8,0,0,0" Background="{DynamicResource AccentBrush}" Opacity="0"
                                    theme:Fx.Mark="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- главная кнопка (цвет акцента): «Далее», «Готово» -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                          theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="Bd" Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1" CornerRadius="8" />
                        <Border CornerRadius="8" Background="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.ShowLevel="0.35"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="8" Background="#1CFFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- красная кнопка (остановка, удаление) -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PanelButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                          theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="Bd" Background="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerEdgeBrush}" BorderThickness="1" CornerRadius="8" />
                        <Border CornerRadius="8" Background="#C8D63030" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="8" Background="#1CFFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- квадратик цвета акцента: выбранный — с белой рамкой (проявляется), нажатие пружинит -->
    <Style x:Key="Swatch" TargetType="ToggleButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}" />
                        <Border CornerRadius="6" BorderBrush="#70FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="6" BorderBrush="White" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== тумблер (CheckBox): бегунок едет с перелётом, при нажатии вытягивается; цвет «вкл» проявляется ===== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Width="44" Height="24" Background="Transparent"
                          theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="Track" CornerRadius="12" Background="#64000000" BorderBrush="#37FFFFFF"
                                BorderThickness="1" />
                        <Border CornerRadius="12" Background="{DynamicResource AccentHoverBrush}"
                                BorderBrush="{DynamicResource AccentEdgeBrush}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border CornerRadius="12" BorderBrush="#4CFFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left"
                                 Margin="3,0,0,0" Opacity="0.8" IsHitTestVisible="False" theme:Fx.KnobTravel="20"
                                 theme:Fx.Knob="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                 theme:Fx.KnobDown="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ползунок ===== -->
    <Style x:Key="SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" Margin="8,0,0,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- точка подрастает при наведении и ещё — пока её тянут -->
                    <Ellipse x:Name="Dot" Width="16" Height="16" Fill="#F4F4F4" Stroke="#46000000" StrokeThickness="1"
                             theme:Fx.GrowHover="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                             theme:Fx.GrowDrag="{Binding IsDragging, RelativeSource={RelativeSource TemplatedParent}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="22" Background="Transparent">
                        <Border Height="4" Margin="8,0" CornerRadius="2" Background="#28FFFFFF"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== тонкая полоса прокрутки (вертикальная и горизонтальная) ===== -->
    <ControlTemplate x:Key="ScrollThumbTemplate" TargetType="Thumb">
        <Grid Margin="1">
            <Border x:Name="T" CornerRadius="4" Background="#46FFFFFF" />
            <Border CornerRadius="4" Background="#40FFFFFF" Opacity="0" IsHitTestVisible="False"
                    theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Template="{StaticResource ScrollThumbTemplate}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource ScrollThumbTemplate}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== прокрутка «поверх» (сетки значков): полоса лежит на содержимом у правого края и не отнимает у него ширину.
         Обычная прокрутка забирала 8 px справа, когда значков больше, чем помещается, — центрированная сетка уезжала на 4 px влево
         и отступы слева и справа становились разными. Полоса тонкая и ложится на пустое поле крайней плитки. ===== -->
    <Style x:Key="OverlayScroll" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- прокрутка рабочего стола: полоса — в поле страницы справа, за краем сетки значков (как у PageScroll), а не поверх
         неё: при крупных значках подсветка крайнего значка и полоса пересекались -->
    <Style x:Key="DesktopScroll" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical" Margin="0,0,-10,0"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== прокрутка страниц (настройки, Zapret, диспетчер задач, корзина): полоса стоит в поле страницы справа, за краем
         содержимого, и ширину у него не отнимает. Раньше полоса забирала 8 px, когда строк больше, чем помещается, — правый край
         строк «гулял» от вкладки к вкладке (и от того, есть ли прокрутка), а на страницах с таблицей шапку приходилось сдвигать.
         Теперь у всех вкладок одинаковые поля слева и справа (18 px от края окна). ===== -->
    <Style x:Key="PageScroll" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical" Margin="0,0,-10,0"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== поле ввода (поиск, сочетание клавиш); подсказка-заглушка берётся из Tag ===== -->
    <Style x:Key="InputBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlFillBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Padding текста TextBox применяет сам, поэтому здесь отступ — только у подсказки
                                 (+2 — внутренний отступ строки ввода), иначе текст сдвигался бы вдвое дальше подсказки -->
                            <Border Padding="{TemplateBinding Padding}" IsHitTestVisible="False">
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#80FFFFFF"
                                           Margin="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <!-- без VerticalAlignment: строку по высоте центрирует сам TextBox (VerticalContentAlignment) -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="0" Padding="0"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <!-- рамка: при наведении светлеет, в фокусе — цвет акцента (оба слоя проявляются плавно) -->
                    <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#43FFFFFF"
                            Opacity="0" IsHitTestVisible="False"
                            theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{DynamicResource AccentEdgeBrush}"
                            Opacity="0" IsHitTestVisible="False"
                            theme:Fx.Show="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== плитка ярлыка на «рабочем столе» ===== -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="{DynamicResource TileWidth}" />
        <Setter Property="Height" Value="{DynamicResource TileHeight}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent"
                          theme:Fx.Press="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="Hl" CornerRadius="12" Background="#1EFFFFFF" BorderThickness="1" BorderBrush="#30FFFFFF"
                                Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Pr" CornerRadius="12" Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- плитку только что бросили под курсор — без подсветки, пока курсор не уйдёт (TileVm.NoHover) -->
                        <DataTrigger Binding="{Binding NoHover}" Value="True">
                            <Setter TargetName="Hl" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="Pr" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- текст всегда с подгонкой к пикселям: иначе в движении WPF рисует его «анимационно», а при остановке перерисовывает
             с подгонкой — подпись прыгала на пиксель и чуть меняла яркость -->
        <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    </Style>

    <!-- ===== всплывающие подсказки: тёмные полупрозрачные, со скруглением ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <!-- шрифт задаём явно: иначе подсказка наследует шрифт значков у кнопки и пишет квадратиками -->
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!-- TipBrush: тонирование подсказок из настроек (UI/Theme/Tips.cs) -->
                    <Border Background="{DynamicResource TipBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="11,8" MaxWidth="420" theme:Fx.PopIn="True">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                                <DataTemplate DataType="{x:Type sys:String}">
                                    <TextBlock theme:Tips.CardText="{Binding}" LineHeight="18" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ContentPresenter.Resources>
                            <!-- строка: первая строка — заголовок, дальше описание -->

                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== меню по правой кнопке ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource MenuBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="4" theme:Fx.PopIn="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- не Transparent: у прозрачных (layered) окон Windows пропускает мышь сквозь пиксели с нулевой прозрачностью,
                         и строка ловила мышь только над буквами. #01 — почти не видно, но мышь ловит -->
                    <Grid Background="#01FFFFFF" theme:Fx.Dim="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}">
                        <!-- подсветка пункта проявляется плавно -->
                        <Border CornerRadius="5" Background="#2AFFFFFF" Opacity="0" IsHitTestVisible="False"
                                theme:Fx.Show="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Bd" Background="#01FFFFFF" CornerRadius="5" Padding="12,7" MinWidth="210"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" Margin="0,0,18,0" />
                                <!-- стрелка у пункта с подменю -->
                                <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource GlyphFont}" FontSize="10"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="4" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource MenuBrush}" BorderBrush="{StaticResource PopupEdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="4"
                                    theme:Fx.PopIn="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4" Background="#30FFFFFF" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
