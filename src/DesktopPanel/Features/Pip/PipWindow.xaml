<Window x:Class="DesktopPanel.Features.Pip.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DesktopPanel.Core.Localization"
        Title="DesktopPanel PiP"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" Background="#01000000" Foreground="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

    <!-- без рамки; в режиме взаимодействия края можно тянуть мышью (ширину рамки задаёт код) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <!-- Всё окно — страница. Саму страницу и рамку показывает окно-картинка PipSurface ровно над этим окном (слоями
         механизма композиции Windows); это окно — прозрачное (фон почти невидимый, #01 — только чтобы ловить мышь),
         в нём лишь полоса ошибки (над страницей, строкой выше), сообщение и тёмный фон, пока браузер не загрузился.
         WebHost — место страницы. Кнопки — в PipSidebar. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- сайт не открылся: почему и что сделать -->
        <Border x:Name="ErrorBar" Grid.Row="0" Background="#E0402020" Padding="10,6" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="ZapretButton" Style="{StaticResource PanelButton}" Height="28" Margin="0,0,6,0"
                            Content="{loc:L pip.zapret_on}" Click="Zapret_Click" />
                    <Button Style="{StaticResource PanelButton}" Height="28" Content="{loc:L pip.retry}"
                            Click="Reload_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="WebHost" Grid.Row="1" Background="#101014" />

        <TextBlock x:Name="Message" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" Margin="20"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />

    </Grid>
</Window>
